###########################################################################################
# sbci_config for ABCD -- UNVALIDATED
# ------------------------------------------------------------------------------
# No ABCD subject has yet completed this package end to end. Use as
# workflow.preprocessing_config, together with workflow.distortion_corrected_input:
# true in sbci_local.json (this tree's DWI and BOLD were corrected upstream).
#
# Written for the lab's ABCD BIDS tree
# (/overflow/zzhanglab/ABCD/SBCI_Finished_ABCD_Data/<batch>/sub-*/ses-*):
#   DWI  already distortion/eddy corrected; 7 b0 + b500 x6, b1000 x15, b2000 x15, b3000 x60
#   BOLD TR 0.8 s, multiband (no SliceTiming in JSON), 383 frames per run
#
# Differences from the lab's existing ABCD SBCI database, which was built with
# single-shell CSD fit to b1000+2000+3000 together at SH order 8, all frames of all
# four rest runs, no slice-timing correction:
#   - fODF: SHELL_POLICY=all gives multi-shell multi-tissue CSD on all four shells, so
#     structural results are NOT interchangeable with that database
#     (sbci_config.abcd_historical reproduces its recipe).
# fMRI matches it: with distortion_corrected_input every rest run is processed, and
# SBCI concatenates them, as the database did (4 x 383 frames).
###########################################################################################

DATASET_NAME=ABCD

# Every non-zero shell reaches the fODF stage, which then fits MSMT-CSD.
SHELL_POLICY=all
DTI_BVALS=(0 1000)
FODF_BVALS=(0 500 1000 2000 3000)

# 96 directions support order 8 (45 coefficients); the historical database used 8.
SH_ORDER=8

# Multi-shell multi-tissue CSD (auto). For results poolable with the lab's
# historical database use sbci_config.abcd_historical instead.
FODF_MODEL=auto

# FMRI_TR guards against applying these settings to another protocol.
# fMRI as the lab's upstream recipe (SBCI_Pipeline ABCD_example / HCP_SBCI step 5):
# -nskip 8 (6.4 s at TR 0.8) and each run's BIDS *_motion.tsv as motion regressors.
FMRI_TR=0.8
FMRI_SKIP_SECONDS=6.4
FMRI_POLYFIT=2
FMRI_STC=none
FMRI_MOTION_REGRESSORS=tsv

PSC_PATH=/path/to/PSC_Pipeline/
SBCI_PATH=/path/to/SBCI_Pipeline/
FREESURFER_PATH=/nas/longleaf/apps/freesurfer/6.0.0/freesurfer/
OUTPUT_PATH=/path/to/outputs

N_RUNS=4
N_SEED=1000
STEPS=75
RNG=1234
BANDWIDTH=0.005
ROIS=("4" "8" "10" "11" "12" "13" "17" "18" "26" "43" "47" "49" "50" "51" "52" "53" "54" "58" "16")

RESOLUTION=ico4
