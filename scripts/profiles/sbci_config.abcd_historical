###########################################################################################
# sbci_config for ABCD -- historical fODF recipe -- UNVALIDATED
# ------------------------------------------------------------------------------
# Reproduces how the lab's existing ABCD SBCI database fitted fODFs: single-shell
# CSD fit to b1000+2000+3000 together (b500 not used), SH order 8. Use this to
# pool new subjects with that database; otherwise use sbci_config.abcd.
# Historical DTI shells were not recorded in the database; b0+1000 is assumed.
# Use with workflow.distortion_corrected_input: true, like the multi-shell profile.
###########################################################################################

DATASET_NAME=ABCD

SHELL_POLICY=explicit
DTI_BVALS=(0 1000)
FODF_BVALS=(0 1000 2000 3000)

# Legacy scilpy (--tolerance 20) kept |b - shell| < 20; scilpy 2.x keeps <= tolerance.
# 19 reproduces the historical selection if a site's b-values sit 20 off a shell.
FODF_TOLERANCE=19

# 96 directions support order 8 (45 coefficients); the historical database used 8.
SH_ORDER=8

FODF_MODEL=ssst

# FMRI_TR guards against applying these settings to another protocol.
# fMRI as the lab's upstream recipe (SBCI_Pipeline ABCD_example / HCP_SBCI step 5):
# -nskip 8 (6.4 s at TR 0.8) and each run's BIDS *_motion.tsv as motion regressors.
FMRI_TR=0.8
FMRI_SKIP_SECONDS=6.4
FMRI_POLYFIT=2
FMRI_STC=none
FMRI_MOTION_REGRESSORS=tsv

PSC_PATH=/path/to/PSC_Pipeline/
SBCI_PATH=/path/to/SBCI_Pipeline/
FREESURFER_PATH=/nas/longleaf/apps/freesurfer/6.0.0/freesurfer/
OUTPUT_PATH=/path/to/outputs

# The lab's ABCD database ran 3 SET tractography sets (sbci_step3_set_1..3 in 40 of 40
# subjects sampled from sbci_finished_batch1); HCP and ADNI ran 4. The SBCI stage takes
# this as parameters.n_runs (longleaf_run_subject.sbatch passes it on).
N_RUNS=3
N_SEED=1000
STEPS=75
RNG=1234
BANDWIDTH=0.005
ROIS=("4" "8" "10" "11" "12" "13" "17" "18" "26" "43" "47" "49" "50" "51" "52" "53" "54" "58" "16")

RESOLUTION=ico4
