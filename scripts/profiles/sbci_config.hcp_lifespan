###########################################################################################
# sbci_config for HCP Aging / HCP Development (HCP-Lifespan) -- UNVALIDATED
# ------------------------------------------------------------------------------
# No HCP subject has yet completed this package end to end. Use as
# workflow.preprocessing_config, together with workflow.distortion_corrected_input:
# true in sbci_local.json (this tree's DWI and BOLD come from the HCP pipelines).
#
# Written for the lab's HCP BIDS trees
# (/overflow/zzhanglab/HCP_Aging_Development_Data/HCP_preprocess_data/HCP_{Aging,Development}/sub-*/ses-V1_MR):
#   DWI  preprocessed, 1.5 mm; 14 b0 + ~93 at b~1500 (1485-1510) + ~92 at b~3000 (2980-3010)
#   BOLD TR 0.8 s, multiband, 478 frames, one rest run; NO JSON sidecars -- the TR is
#        read from the NIfTI header, which declares seconds
#
# Differences from the lab's existing HCP SBCI outputs, built with single-shell CSD fit
# to b1500+3000 together at SH order 8 (and which, extracting with --tolerance 20,
# silently dropped the b=2980 volumes):
#   - fODF: SHELL_POLICY=all gives multi-shell multi-tissue CSD on every volume of both
#     shells, so structural results are NOT interchangeable with those outputs.
###########################################################################################

DATASET_NAME=HCP_Lifespan

# Every non-zero shell reaches the fODF stage, which then fits MSMT-CSD.
SHELL_POLICY=all
DTI_BVALS=(0 1500)
FODF_BVALS=(0 1500 3000)

# ~185 directions support order 8 easily; the historical outputs used 8.
SH_ORDER=8

# Multi-shell multi-tissue CSD (auto). For results poolable with the lab's
# historical database use sbci_config.hcp_lifespan_historical instead.
FODF_MODEL=auto

# FMRI_TR guards against applying these settings to another protocol.
# fMRI as the lab's upstream recipe (SBCI_Pipeline ABCD_example / HCP_SBCI step 5):
# -nskip 8 (6.4 s at TR 0.8) and each run's BIDS *_motion.tsv as motion regressors.
FMRI_TR=0.8
FMRI_SKIP_SECONDS=6.4
FMRI_POLYFIT=2
FMRI_STC=none
FMRI_MOTION_REGRESSORS=tsv

PSC_PATH=/path/to/PSC_Pipeline/
SBCI_PATH=/path/to/SBCI_Pipeline/
FREESURFER_PATH=/nas/longleaf/apps/freesurfer/6.0.0/freesurfer/
OUTPUT_PATH=/path/to/outputs

N_RUNS=4
N_SEED=1000
STEPS=75
RNG=1234
BANDWIDTH=0.005
ROIS=("4" "8" "10" "11" "12" "13" "17" "18" "26" "43" "47" "49" "50" "51" "52" "53" "54" "58" "16")

RESOLUTION=ico4
