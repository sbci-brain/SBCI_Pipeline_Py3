###########################################################################################
# sbci_config for HCP Aging / Development -- historical fODF recipe -- UNVALIDATED
# ------------------------------------------------------------------------------
# Reproduces how the lab's existing HCP SBCI outputs fitted fODFs: single-shell CSD
# fit to b1500+3000 together, SH order 8, DTI on b0+1500. Use this to pool new
# subjects with those outputs; otherwise use sbci_config.hcp_lifespan.
# Use with workflow.distortion_corrected_input: true, like the multi-shell profile.
###########################################################################################

DATASET_NAME=HCP_Lifespan

SHELL_POLICY=explicit
DTI_BVALS=(0 1500)
FODF_BVALS=(0 1500 3000)

# The historical extraction (legacy scilpy, --tolerance 20) kept |b - shell| < 20, so it
# dropped the five b=2980 volumes (historical fodf.bval: 14 b0 + 93 + 87). scilpy 2.x
# keeps |b - shell| <= tolerance; 19 reproduces the historical selection.
FODF_TOLERANCE=19

# ~185 directions support order 8 easily; the historical outputs used 8.
SH_ORDER=8

FODF_MODEL=ssst

# FMRI_TR guards against applying these settings to another protocol.
# fMRI as the lab's upstream recipe (SBCI_Pipeline ABCD_example / HCP_SBCI step 5):
# -nskip 8 (6.4 s at TR 0.8) and each run's BIDS *_motion.tsv as motion regressors.
FMRI_TR=0.8
FMRI_SKIP_SECONDS=6.4
FMRI_POLYFIT=2
FMRI_STC=none
FMRI_MOTION_REGRESSORS=tsv

PSC_PATH=/path/to/PSC_Pipeline/
SBCI_PATH=/path/to/SBCI_Pipeline/
FREESURFER_PATH=/nas/longleaf/apps/freesurfer/6.0.0/freesurfer/
OUTPUT_PATH=/path/to/outputs

N_RUNS=4
N_SEED=1000
STEPS=75
RNG=1234
BANDWIDTH=0.005
ROIS=("4" "8" "10" "11" "12" "13" "17" "18" "26" "43" "47" "49" "50" "51" "52" "53" "54" "58" "16")

RESOLUTION=ico4
