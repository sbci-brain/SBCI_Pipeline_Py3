#!/usr/bin/env python3
"""Narrow mrconvert adapter for SBCI's label-volume restride operation."""

from __future__ import annotations

import sys
from pathlib import Path

import nibabel as nib
import numpy as np


def main() -> int:
    args = sys.argv[1:]
    if not args:
        return 2
    source = Path(args[0])
    output: Path | None = None
    index = 1
    while index < len(args):
        if args[index] == "-stride":
            index += 2
        elif args[index].startswith("-"):
            index += 1
        else:
            output = Path(args[index])
            index += 1
    if output is None:
        print("usage: mrconvert INPUT -stride 1,2,3 OUTPUT -force", file=sys.stderr)
        return 2
    image = nib.load(str(source))
    data = np.asanyarray(image.dataobj)
    output.parent.mkdir(parents=True, exist_ok=True)
    temporary = output.with_name(output.name + ".tmp.nii.gz") if output.resolve() == source.resolve() else output
    nib.save(nib.Nifti1Image(data, image.affine), str(temporary))
    if temporary != output:
        temporary.replace(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
