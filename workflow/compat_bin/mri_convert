#!/usr/bin/env python3
"""Small mri_convert-compatible MGZ/NIfTI converter using nibabel."""

from __future__ import annotations

import sys
from pathlib import Path

import nibabel as nib
import numpy as np


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: mri_convert INPUT OUTPUT", file=sys.stderr)
        return 2
    source, output = map(Path, sys.argv[1:])
    output.parent.mkdir(parents=True, exist_ok=True)
    image = nib.load(str(source))
    nib.save(nib.Nifti1Image(np.asanyarray(image.dataobj), image.affine), str(output))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
