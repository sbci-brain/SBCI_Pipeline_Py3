#!/usr/bin/env python3
"""Small mris_convert-compatible FreeSurfer surface to legacy VTK adapter."""

from __future__ import annotations

import sys
from pathlib import Path

import nibabel.freesurfer.io as fsio
import numpy as np


def main() -> int:
    args = sys.argv[1:]
    to_scanner = False
    if args and args[0] == "--to-scanner":
        to_scanner = True
        args = args[1:]
    if len(args) != 2:
        print("usage: mris_convert [--to-scanner] INPUT_SURFACE OUTPUT.vtk", file=sys.stderr)
        return 2
    source, output = map(Path, args)
    coords, faces, metadata = fsio.read_geometry(str(source), read_metadata=True)
    coords = np.asarray(coords, dtype=float)
    if to_scanner:
        cras = np.asarray(metadata.get("cras", (0.0, 0.0, 0.0)), dtype=float)
        coords = coords + cras
    output.parent.mkdir(parents=True, exist_ok=True)
    with output.open("w", encoding="ascii", newline="\n") as stream:
        stream.write("# vtk DataFile Version 3.0\nCyberNeuro FreeSurfer surface\nASCII\nDATASET POLYDATA\n")
        stream.write(f"POINTS {len(coords)} float\n")
        for x, y, z in coords:
            stream.write(f"{x:.9g} {y:.9g} {z:.9g}\n")
        stream.write(f"POLYGONS {len(faces)} {len(faces) * 4}\n")
        for a, b, c in faces:
            stream.write(f"3 {int(a)} {int(b)} {int(c)}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
