{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberneuro.local/schemas/sbci.handoff.schema.json",
  "title": "CyberNeuro SBCI inter-skill artifact handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "producer", "subject", "status", "read_only", "artifact_root", "artifacts", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "stage", "environment"],
      "properties": {
        "skill": {"type": "string", "minLength": 1},
        "stage": {"enum": ["dwi_correction", "fmri_correction", "prepare_data", "t1_dwi_registration", "freesurfer", "fodf_tissue", "fsfast", "psc", "sbci"]},
        "environment": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      }
    },
    "subject": {"type": "string", "minLength": 1},
    "session": {"type": ["string", "null"]},
    "status": {"const": "complete"},
    "read_only": {"const": true},
    "artifact_root": {"type": "string"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "media_type": {"type": "string"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["command", "container", "completed_at"],
      "properties": {
        "command": {"type": "string"},
        "container": {"type": "string"},
        "completed_at": {"type": "string"}
      }
    }
  }
}
